# Copy to .env and fill real values. NEVER commit .env.
# Database
DATABASE_URL=postgresql://support:support@db:5432/supportdb
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=supportdb
# Backend
JWT_SECRET=change-me-to-32-plus-random-chars-xxxx
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# AI — leave GEMINI_API_KEY empty to run in mock mode (no cost, works offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Frontend
VITE_API_URL=http://localhost:4000/api
